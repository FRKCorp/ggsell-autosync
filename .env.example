# --- FazerCards ---
FAZERCARDS_API_KEY=your_fazercards_api_key
FAZERCARDS_BASE_URL=https://api.fzr.cards/api/v2

# --- GGSell V2 (каталог: офферы/опции/продукты, статичный ключ) ---
GGSELL_API_KEY=your_ggsell_api_key
GGSELL_BASE_URL=https://seller.ggsel.com

# --- GGSell V1 (заказы/чат, отдельный ключ + seller_id, логин по подписи ---
# Найти в личном кабинете GGSell, отдельно от GGSELL_API_KEY выше (это другой ключ).
GGSELL_V1_SELLER_ID=your_ggsell_seller_id
GGSELL_V1_API_KEY=your_ggsell_v1_api_key

# --- Вебхук для уведомлений о новых продажах (notification_settings.url на каждом оффере) ---
GGSELL_WEBHOOK_URL=https://your-domain.example/webhooks/ggsell

# --- База данных ---
# Локальная разработка (Postgres в docker-compose с проброшенным портом на localhost):
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ggsell_autosync
# На сервере (app/scheduler и db в одной docker-compose сети, хост — имя сервиса):
#   DATABASE_URL=postgresql+psycopg://user:password@db:5432/ggsell_autosync
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ggsell_autosync

# Те же значения user/password, что и в DATABASE_URL выше — используются
# docker-compose.yml для инициализации контейнера Postgres. На сервере обязательно
# поставь стойкий пароль вместо "password" и продублируй его в обеих местах.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ggsell_autosync

# --- Прайсер ---
# Курс, к которому привязана наценка (например, USD -> RUB)
EXCHANGE_RATE_USD_TO_RUB=95.0
# Наценка в процентах поверх цены поставщика с учётом курса
MARKUP_PERCENT=15.0

# --- Защита от продажи в убыток ---
# Максимально допустимое расхождение цены между локальным кэшем и
# актуальным ответом API поставщика в момент заказа (в процентах).
# Если расхождение больше — заказ не отправляется автоматически,
# уходит в ручной режим.
MAX_PRICE_DEVIATION_PERCENT=5.0
# Минимальная маржа в процентах, ниже которой автоматическая продажа
# не допускается ни при каких обстоятельствах.
MIN_MARGIN_PERCENT=3.0

# --- Синхронизация каталога ---
CATALOG_SYNC_INTERVAL_HOURS=12

# --- Уведомления администратору при сбоях/ручном режиме ---
ADMIN_NOTIFY_CHANNEL=telegram
ADMIN_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_CHAT_ID=your_telegram_chat_id_here
