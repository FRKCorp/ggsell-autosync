# =====================================================================
#  Настройки сервера. Секреты хранятся только здесь — файл .env не
#  попадает в git.
#
#  1. Заполните строки под пометкой «ЗАПОЛНИТЕ» (разделы 1–4).
#  2. Проверьте: docker compose run --rm app python scripts/check_env.py
#     (покажет, что заполнено и подключается, сами ключи не печатает).
#  3. Примените: docker compose up -d --force-recreate
#
#  Остальное (раздел 5 и ниже) можно не трогать.
# =====================================================================


# ---------- 1. Домен ---------------------------------------------------
# ЗАПОЛНИТЕ: домен или поддомен, A-запись которого указывает на IP этого
# сервера. Без https:// и слешей, например: shop.example.ru
# На него GGSell присылает уведомления о продажах; HTTPS-сертификат
# получается сам. Несколько — через запятую: example.ru, www.example.ru
DOMAIN=


# ---------- 2. GGSell (кабинет продавца → раздел API) ------------------
# ЗАПОЛНИТЕ: API-ключ продавца (API v2) — каталог, лоты, цены.
GGSELL_API_KEY=
# ЗАПОЛНИТЕ: ID продавца и API-ключ старого API (V1) — заказы и сообщения
# покупателям. Это ДРУГОЙ ключ, не тот, что выше.
GGSELL_V1_SELLER_ID=
GGSELL_V1_API_KEY=


# ---------- 3. FazerCards ----------------------------------------------
# ЗАПОЛНИТЕ: API-ключ аккаунта FazerCards (нужна активная подписка и
# баланс — с него оплачиваются заказы покупателей).
FAZERCARDS_API_KEY=


# ---------- 4. Telegram-бот администратора -----------------------------
# ЗАПОЛНИТЕ: токен бота от @BotFather (вида 1234567890:AAH...).
ADMIN_TELEGRAM_BOT_TOKEN=
# ЗАПОЛНИТЕ: ваш chat_id (число, его показывает @userinfobot). Несколько
# админов — через запятую. Каждому нужно нажать Start в боте.
ADMIN_TELEGRAM_CHAT_ID=
# Только если сервер в России (Telegram там заблокирован): HTTP-прокси
# вне РФ, вида http://логин:пароль@IP:порт. Иначе — оставить пустым.
TELEGRAM_PROXY=


# ---------- 5. База данных (заполняется при установке) -----------------
# Пароль задаётся один раз при установке — потом не менять (иначе
# потеряется доступ к уже созданной базе).
POSTGRES_USER=ggsell
POSTGRES_PASSWORD=
POSTGRES_DB=ggsell_autosync
# Только для запуска без Docker (локальная разработка). На сервере
# docker-compose собирает адрес БД сам из строк выше.
# DATABASE_URL=postgresql+psycopg://ggsell:ПАРОЛЬ@localhost:5432/ggsell_autosync


# ---------- 6. Цены (начальные значения) -------------------------------
# Наценка, надбавка к курсу и выключатель прайсера дальше меняются из
# Telegram-панели «Авто-прайсер» и хранятся в БД — правка здесь после
# первого запуска уже не действует.
# Глобальная наценка, %. «Чистая»: комиссии GGSell закладываются сверху.
MARKUP_PERCENT=15.0
# Курс USD→RUB = курс ЦБ + эта надбавка, %.
EXCHANGE_RATE_PREMIUM_PERCENT=5.0
# Запасной курс — только если курс ЦБ ещё ни разу не удалось получить.
EXCHANGE_RATE_USD_TO_RUB=95.0
# Отправлять ли пересчитанные цены на GGSell.
PRICER_ENABLED=true
# Цена лота обновляется при отклонении от расчётной больше чем на %
# (при синхронизации раз в 12 ч; смена наценки из бота — без порога).
PRICE_PUSH_THRESHOLD_PERCENT=1


# ---------- 7. Защита от продажи в убыток ------------------------------
# Если цена у FazerCards в момент заказа выросла больше чем на % от
# последней известной — заказ уходит на ручной разбор.
MAX_PRICE_DEVIATION_PERCENT=5.0
# Минимальная маржа, % — ниже неё цена лота поднимается сразу (с алертом).
MIN_MARGIN_PERCENT=3.0


# ---------- 8. Расписание ----------------------------------------------
# Синхронизация каталога и цен, часы.
CATALOG_SYNC_INTERVAL_HOURS=12
# Как часто спрашивать FazerCards о статусе заказов в работе, сек.
FZ_ORDER_POLL_SECONDS=15
# Как часто искать продажи GGSell, по которым не пришёл вебхук, мин.
ORDER_SWEEP_MINUTES=5
# Бэкап БД: время по UTC (00:30 UTC = 03:30 МСК) и сколько дампов хранить.
BACKUP_AT_UTC=00:30
BACKUP_KEEP=7


# ---------- 9. Служебное (не трогать) -----------------------------------
FAZERCARDS_BASE_URL=https://api.fzr.cards/api/v2
GGSELL_BASE_URL=https://seller.ggsel.com
# Адрес вебхука по умолчанию — https://<DOMAIN>/webhooks/ggsell.
# GGSELL_WEBHOOK_URL=
